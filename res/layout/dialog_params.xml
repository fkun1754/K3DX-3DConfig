<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_pkg_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#4A6CF7"
            android:paddingBottom="8dp"/>

        <!-- 快速匹配提示 -->
        <TextView
            android:id="@+id/tv_match_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#008800"
            android:paddingBottom="6dp"/>

        <!-- 参考模板选择 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="参考模板"
            android:textSize="14sp"
            android:textColor="#1A1C20"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/sp_ref"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/ref_btn_bg"
            android:textColor="#1A1C20"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="▾ 点击选择/搜索模板"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="点击上方选择/搜索模板"
            android:textSize="11sp"
            android:textColor="#999999"
            android:layout_marginBottom="8dp"/>

        <!-- 模板参数只读展示 -->
        <TextView
            android:id="@+id/tv_param_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#666666"
            android:paddingBottom="10dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#EDEFF2"/>

        <!-- 3D深度 (persist.sys.3deffect, 同系统3Dconfig；按应用记忆) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="3D深度"
            android:textSize="14sp"
            android:textColor="#1A1C20"
            android:textStyle="bold"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <SeekBar
                android:id="@+id/sb_depth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="20"/>
            <TextView
                android:id="@+id/tv_depth"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="14sp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#EDEFF2"/>

        <!-- 3D深度悬浮窗开关（按应用） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="3D深度悬浮窗"
                android:textSize="14sp"
                android:textColor="#1A1C20"
                android:textStyle="bold"/>
            <Switch
                android:id="@+id/sw_game_fb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:track="@drawable/switch_track" android:thumb="@drawable/switch_thumb"/>
        </LinearLayout>

        <!-- 全部游戏开启（仅在悬浮窗开关开启后显示） -->
        <CheckBox
            android:id="@+id/cb_all_fb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="全部开启"
            android:textSize="13sp"
            android:visibility="gone"/>
    </LinearLayout>
</ScrollView>
