<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_app3d_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#4A6CF7"
            android:paddingBottom="8dp"/>

        <!-- 启动时直接开启3D（含3D视角，第二个选项） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="启动时直接开启3D"
            android:textSize="14sp"
            android:textColor="#1A1C20"
            android:textStyle="bold"/>

        <!-- 启动3D子选项：模式 | 3D视角 并排对齐，开关独立最后一列 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="模式"
                    android:textSize="13sp"
                    android:textColor="#333333"/>
                <Spinner
                    android:id="@+id/sp_auto_mode"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3D视角"
                    android:textSize="13sp"
                    android:textColor="#333333"/>
                <Spinner
                    android:id="@+id/sp_vp"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <Switch
                android:id="@+id/sw_auto3d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#EDEFF2"/>

        <!-- 开启悬浮按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="开启悬浮按钮"
                android:textSize="14sp"
                android:textColor="#1A1C20"
                android:textStyle="bold"/>
            <Switch
                android:id="@+id/sw_app_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- 子选项（仅开启悬浮按钮后显示，缩进两字符） -->
        <LinearLayout
            android:id="@+id/ll_sub_opts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="20dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="模式按钮"
                    android:textSize="13sp"
                    android:textColor="#333333"/>
                <Switch
                    android:id="@+id/sw_show_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="20dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="视角按钮"
                    android:textSize="13sp"
                    android:textColor="#333333"/>
                <Switch
                    android:id="@+id/sw_show_vp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 悬浮按钮功能说明（重点说明） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#666666"
            android:paddingTop="8dp"
            android:text="说明：\n· 启动时直接开启3D：进入应用自动开3D（可选HSBS/FSBS/2D转3D模式）；3D视角=右左/左右（画面反视差时切换）\n· 悬浮按钮：主按钮点击切换2D↔3D；模式按钮循环切换HSBS（半幅）/FSBS（全幅）/2D转3D（深度映射）；视角按钮切换右左/左右\n· 按钮靠边自动收缩为细条，点击/滑动唤出；离开应用自动回到2D\n· V5G：横屏旋转180°视角自动跟随互换（已修复）"/>
    </LinearLayout>
</ScrollView>
